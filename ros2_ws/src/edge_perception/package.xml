<?xml version="1.0"?>
<package format="3">
  <name>edge_perception</name>
  <version>0.1.0</version>
  <description>Thin ROS 2 wrappers over the stdlib-only perception core.</description>
  <maintainer email="vivsterhuang@gmail.com">vivh3</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
