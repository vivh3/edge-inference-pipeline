__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Nsight captures are large; keep the screenshots and summaries, not the raw traces.
results/traces/*.nsys-rep
results/traces/*.sqlite

# Probe frames are photographs of a real room. The manifest records the
# capture settings and per-frame brightness, and the baseline JSON records the
# per-frame validation outcome, which is what a reader needs to judge the set;
# the images themselves stay local.
#
# The glob covers every probe set, not just results/probe/. probe-live/ and
# probe-varied/ were added later and committed twenty photographs to a public
# repository before anyone noticed, because the pattern named one directory
# instead of the kind of thing it was protecting.
results/probe*/*.jpg
results/probe*/*.png

# Demo recordings are terminal casts, plus a gif made from one. Anything else
# that lands here stays local: the telemetry CSV a demo run writes, and above
# all video or stills of the rig, which show the same room the probe frames do.
results/demo/*
!results/demo/*.cast
!results/demo/*.gif
